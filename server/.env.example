# Swar backend configuration. Copy to .env and adjust; every value shown is
# the default unless noted. Durations use Go syntax (30s, 5m, 12h).

# ---- Server ----
SWAR_ENV=development              # "production" makes SWAR_TOKEN_SECRET mandatory
SWAR_ADDR=:8765
SWAR_LOG_LEVEL=info               # debug | info | warn | error
SWAR_CORS_ORIGINS=*               # comma-separated origins, e.g. https://app.example.com
SWAR_TRUST_PROXY=false            # true only behind a proxy that overwrites X-Forwarded-For

# ---- Storage and identity ----
SWAR_DB_PATH=data/swar.db
# 32+ random characters; generate with: openssl rand -hex 32
# Required in production. In development a random secret is used and device
# tokens stop working after a restart.
SWAR_TOKEN_SECRET=
SWAR_TOKEN_TTL=8760h

# ---- Limits ----
SWAR_MAX_BODY_BYTES=65536
SWAR_REQUEST_TIMEOUT=30s
SWAR_RATE_LIMIT_RPS=10            # per client IP; Deep Search costs 10 tokens
SWAR_RATE_LIMIT_BURST=40
SWAR_CACHE_MAX_ENTRIES=20000

# ---- Saavn catalog ----
SAAVN_BASE_URL=https://www.jiosaavn.com/api.php
SAAVN_TIMEOUT=8s
SAAVN_MAX_CONCURRENCY=8
SAAVN_MAX_RETRIES=2
SAAVN_MAX_BODY_BYTES=4194304
# Off by default. Turning these on means you, the operator, are responsible
# for having the right to stream / allow offline copies of this catalog in
# your region. See docs/DECISIONS.md.
SAAVN_MEDIA_URLS_ENABLED=false
SAAVN_DOWNLOADS_ENABLED=false

# ---- Deep Search (yt-dlp) ----
YTDLP_PATH=yt-dlp
DEEPSEARCH_ENABLED=true           # metadata search only
DEEPSEARCH_TIMEOUT=25s
DEEPSEARCH_MAX_RESULTS=10
DEEPSEARCH_CONCURRENCY=2
DEEPSEARCH_MAX_OUTPUT_BYTES=8388608
DEEPSEARCH_PLAYBACK_ENABLED=false # resolve Deep Search results to stream URLs
DEEPSEARCH_DOWNLOADS_ENABLED=false

# ---- Swar Jam ----
JAM_MAX_PARTICIPANTS=20
JAM_MAX_QUEUE=200
JAM_IDLE_TTL=30m
JAM_MAX_LIFETIME=12h

# ---- Radio ----
RADIO_SESSION_TTL=6h

# ---- Admin (maintenance mode and popups) ----
# The admin API under /v1/admin is off unless both are set. Use a long,
# random password and keep it out of the repository.
ADMIN_USERNAME=
ADMIN_PASSWORD=
