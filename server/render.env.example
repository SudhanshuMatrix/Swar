# ==============================================================================
# Swar Backend - Render Environment Variables (Copy & Paste)
# ==============================================================================
# In Render Dashboard -> Your Web Service -> Environment -> "Add from .env":
# Paste the content below and adjust if needed.
# ==============================================================================

# ---- Server & Deployment ----
SWAR_ENV=production
SWAR_LOG_LEVEL=info
SWAR_TRUST_PROXY=true
SWAR_CORS_ORIGINS=*

# Generate a 32+ char secret for device auth:
SWAR_TOKEN_SECRET=3f9e8a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f
SWAR_TOKEN_TTL=8760h

# Persistent Disk mount path on Render (e.g. /data/swar.db or data/swar.db)
SWAR_DB_PATH=data/swar.db

# ---- Limits & Cache ----
SWAR_RATE_LIMIT_RPS=15
SWAR_RATE_LIMIT_BURST=50
SWAR_CACHE_MAX_ENTRIES=20000
SWAR_REQUEST_TIMEOUT=30s

# ---- Music Metadata Engine (OMMR-inspired) ----
MUSIC_PROVIDER_DEEZER_ENABLED=true
MUSIC_PROVIDER_ITUNES_ENABLED=true
MUSIC_PROVIDER_MUSICBRAINZ_ENABLED=true
MUSIC_SEARCH_TIMEOUT=8s
MUSIC_MAX_CONCURRENCY=10

# ---- Spotify Integration (Recommended for ultra-fast Main Search) ----
# Get free client credentials in 1 minute from https://developer.spotify.com/dashboard:
# 1. Click "Create app"
# 2. Put App name "Swar", Redirect URI "http://localhost"
# 3. Copy your Client ID and Client Secret below and set MUSIC_PROVIDER_SPOTIFY_ENABLED=true
# When enabled, Swar uses Spotify for instant main song searches and Deep Search for all other providers.
MUSIC_PROVIDER_SPOTIFY_ENABLED=true
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ---- Deep Search (YouTube / yt-dlp) ----
YTDLP_PATH=yt-dlp
DEEPSEARCH_ENABLED=true
DEEPSEARCH_PLAYBACK_ENABLED=true
DEEPSEARCH_DOWNLOADS_ENABLED=false
DEEPSEARCH_TIMEOUT=25s
DEEPSEARCH_MAX_RESULTS=10
DEEPSEARCH_CONCURRENCY=2

# ---- Swar Jam (WebSockets) ----
JAM_MAX_PARTICIPANTS=25
JAM_MAX_QUEUE=200
JAM_IDLE_TTL=30m
JAM_MAX_LIFETIME=12h
